{
  "name": "@powergrid/core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "lint": "echo 'lint do core-service será configurado na etapa de qualidade'",
    "test:integration": "tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "fastify": "5.2.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}